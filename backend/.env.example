PORT=8080
NODE_ENV=development

DATABASE_URL=postgresql://dashboard:dashboard@db:5432/dashboard

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173

OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/api/services/github/oauth/callback


# OAuth (per-user login) for the `youtube` service.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_CALLBACK_URL=http://localhost:8080/api/services/youtube/oauth/callback

# 32-byte key, hex-encoded (64 hex characters) — encrypts third-party credentials at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# Comma-separated emails promoted to ADMIN on registration — the only way to get the first admin.
ADMIN_EMAILS=

# Confirmation emails: defaults target the MailHog service from docker-compose.yml (fake SMTP
# server, web inbox at http://localhost:8025). Point at a real SMTP provider to send for real.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dashboard <no-reply@dashboard.local>
